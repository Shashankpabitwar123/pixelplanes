{
  "name": "bitplanes-live-background",
  "version": "1.0.0",
  "description": "Real-time multiplayer browser flight game with server-authoritative combat, regional WebSocket rooms, LiveKit voice, and adaptive bot AI",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test:room": "node --test server/room-runtime.test.js",
    "test:server": "node --test server/room-protocol.test.js",
    "test:directory": "node --test server/room-directory.test.js",
    "test:voice": "node --test server/livekit-auth.test.js",
    "test:bot": "node --test src/game/bot-ai.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "server:start": "node server/index.js",
    "server:dev": "node --watch server/index.js"
  },
  "keywords": [
    "browser-game",
    "multiplayer",
    "react",
    "websocket",
    "livekit",
    "real-time",
    "game-ai",
    "server-authoritative"
  ],
  "homepage": "https://pixelplanes.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shashankpabitwar123/bit-planes.git"
  },
  "author": "Shashank S. Pabitwar",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "^5.12.1",
    "vite": "^8.1.4",
    "ws": "^8.21.0"
  }
}
